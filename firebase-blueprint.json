{
  "entities": {
    "Asset": {
      "title": "Asset",
      "description": "Represents an industrial vehicle/logistics asset up for auction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "modelYear": { "type": "integer" },
        "plateNumber": { "type": "string" },
        "condition": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "startingPrice": { "type": "number" },
        "highestBid": { "type": "number" },
        "status": { "type": "string", "enum": ["Open", "Sold"] },
        "imageUrl": { "type": "string" },
        "bids": { "type": "array" }
      },
      "required": ["id", "name", "brand", "category", "modelYear", "plateNumber", "condition", "location", "description", "startingPrice", "highestBid", "status", "imageUrl", "bids"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Represents an administrative user who can manage assets and users.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Represents a brand name used for assets filtering and dropdown selection.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Represents a category name used for assets classification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Condition": {
      "title": "Condition",
      "description": "Represents a physical condition name used for assets description.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "Represents an external client who can log in to view prices and place bids.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "verificationCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "name", "phone", "status", "emailVerified", "verificationCode", "createdAt"]
    },
    "BiddingRequest": {
      "title": "BiddingRequest",
      "description": "Represents a request for bidding access with submitted proof of payment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "userName": { "type": "string" },
        "requestType": { "type": "string" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "userName", "requestType", "proofUrl", "status", "createdAt"]
    },
    "RefundRequest": {
      "title": "RefundRequest",
      "description": "Represents a request for bidding fee refund with submitted proof of payment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "userName": { "type": "string" },
        "phone": { "type": "string" },
        "purpose": { "type": "string" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "userName", "phone", "purpose", "proofUrl", "status", "createdAt"]
    },
    "WaSession": {
      "title": "WaSession",
      "description": "Represents a WhatsApp connection session for an admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "connectedPhone": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "status", "connectedPhone", "updatedAt"]
    },
    "WaTemplate": {
      "title": "WaTemplate",
      "description": "Represents a WhatsApp broadcast message template.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name", "category", "content"]
    }
  },
  "firestore": {
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Collection of logistics assets open for public catalog viewing and bidding."
    },
    "/admins/{adminEmail}": {
      "schema": "AdminUser",
      "description": "Collection of authorized administrator user details."
    },
    "/brands/{brandId}": {
      "schema": "Brand",
      "description": "Collection of master brands for assets selection."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of master categories for assets selection."
    },
    "/conditions/{conditionId}": {
      "schema": "Condition",
      "description": "Collection of master physical conditions for assets selection."
    },
    "/registered_users/{email}": {
      "schema": "RegisteredUser",
      "description": "Collection of registered external user accounts with verification status."
    },
    "/bidding_requests/{requestId}": {
      "schema": "BiddingRequest",
      "description": "Collection of bidding access requests."
    },
    "/refund_requests/{requestId}": {
      "schema": "RefundRequest",
      "description": "Collection of refund requests."
    },
    "/wa_sessions/{sessionId}": {
      "schema": "WaSession",
      "description": "Collection of WhatsApp sessions."
    },
    "/wa_templates/{templateId}": {
      "schema": "WaTemplate",
      "description": "Collection of WhatsApp message templates."
    }
  }
}
